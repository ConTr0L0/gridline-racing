# Copy to .env.local (ignored by git). Never put your F1 TV password or token here.
# Use the PC's LAN IPv4 address for a physical Android phone; use 10.0.2.2 for Android Emulator.
EXPO_PUBLIC_F1_TIMING_WS_URL=ws://192.168.1.20:8765
EXPO_PUBLIC_F1_TIMING_ACCESS_KEY=replace-with-a-long-alphanumeric-key

# The same access key protects the local bridge when it listens on the LAN.
F1_TIMING_HOST=0.0.0.0
F1_TIMING_PORT=8765
F1_TIMING_ACCESS_KEY=replace-with-a-long-alphanumeric-key
