# Keep EAS upload exclusions aligned with .gitignore.
.git/
node_modules/
.venv/
__pycache__/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files and backups
.env*
*.bak

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local-only timing bridge; the Expo app does not import it.
/live-service/
